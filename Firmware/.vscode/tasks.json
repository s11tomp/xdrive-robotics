{
    // Build tasks for VS Code (xdrive/docs/ide.md). Flashing is deliberately not a task: use
    // xdrive/tools/usb_flash.py or swd_flash.py, which back up the flash and check the write.
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "make -C ../xdrive -j8",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "panel": "new"
            },
            "problemMatcher": {
                "base": "$gcc",
                "fileLocation": ["relative", "${workspaceFolder}"]
            }
        },
        {
            "label": "clean",
            "type": "shell",
            "command": "make -C ../xdrive clean",
            "problemMatcher": []
        }
    ]
}
