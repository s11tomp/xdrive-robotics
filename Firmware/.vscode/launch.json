{
    // Cortex-Debug configurations (xdrive/docs/ide.md). Both attach to the running firmware and never
    // flash it. Attaching halts the core; while it is halted, TIM1 is frozen with its outputs off, so
    // the motor turns freely.
    "version": "0.2.0",
    "configurations": [
        {
            "type": "cortex-debug",
            "servertype": "openocd",
            "request": "attach",
            "name": "Attach - ST-Link",
            "executable": "${workspaceRoot}/build/ODriveFirmware.elf",
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32f4x.cfg"
            ],
            "svdFile": "${workspaceRoot}/Board/v3/STM32F40x.svd",
            "cwd": "${workspaceRoot}"
        },
        {
            "type": "cortex-debug",
            "servertype": "openocd",
            "request": "attach",
            "name": "Attach - ST-Link - FreeRTOS threads",
            "executable": "${workspaceRoot}/build/ODriveFirmware.elf",
            "rtos": "FreeRTOS",
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32f4x.cfg"
            ],
            "svdFile": "${workspaceRoot}/Board/v3/STM32F40x.svd",
            "cwd": "${workspaceRoot}"
        }
    ]
}
